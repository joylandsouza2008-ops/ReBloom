# Copy to .env for local runs. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Shown on the privacy page as the contact for questions and complaints (DPDP Act)
GRIEVANCE_EMAIL=
GRIEVANCE_NAME=Team Phoenix Queens
JOOBLE_API_KEY=
# Use in.jooble.org if Jooble gave you a key for the India site
JOOBLE_HOST=jooble.org
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
AI_CALLS_PER_HOUR=40
GUEST_CALLS_PER_HOUR=15
GUEST_CALLS_PER_IP_HOUR=30
